<?xml version="1.0" encoding="utf-8"?>
<!-- 연동판(full)에만 들어가는 서비스. 접근성/알림 접근 권한이 필요해서
     인터넷에서 받아 설치하면 Play 프로텍트가 막을 수 있다 → PC에서 adb로 설치 (install_android_app.bat) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 브라우저 주소 읽기 + 플로팅 녹화 버튼 -->
        <service
            android:name=".LinkService"
            android:exported="true"
            android:label="@string/link_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/link_service" />
        </service>

        <!-- 브라우저 재생 위치/일시정지 읽기 (미디어 세션 접근용) -->
        <service
            android:name=".MediaWatcher"
            android:exported="true"
            android:label="@string/media_watcher_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
